# Sanity CMS — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Opsiyonel: önizleme / taslak içerik için
# SANITY_API_READ_TOKEN=

# Sitenin canlı URL'i — sitemap, OG, JSON-LD için kullanılır
NEXT_PUBLIC_SITE_URL=https://yukselinhobileri.com

# Plausible analytics (opsiyonel)
# Boş bırakırsanız analytics script'i hiç yüklenmez.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yukselinhobileri.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Sanity webhook secret
# Sanity'de yayın yapınca site'ı anında güncellemek için kullanılır.
# Rastgele uzun bir string üret (örn. openssl rand -hex 32) ve hem buraya
# hem de sanity.io/manage > Webhooks > URL query param'ına yaz.
SANITY_WEBHOOK_SECRET=change-me

# === Admin Paneli (/admin) ===

# Admin paneline giriş için Basic Auth şifresi.
# Tarayıcı /admin'e gidince kullanıcı adı "admin", şifre bu değer.
ADMIN_PASSWORD=change-me

# Fal.ai API anahtarı — AI görsel üretimi için.
# https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# Görsel düzenleme modeli (opsiyonel).
# openai/gpt-image-2/edit  → OpenAI GPT Image 2 (varsayılan)
# fal-ai/nano-banana/edit  → Gemini tabanlı Nano Banana
# FAL_EDIT_MODEL=openai/gpt-image-2/edit

# Sanity yazma (write) token — admin'den ürün yayınlamak için gerekli.
# sanity.io/manage → projen → API → Tokens → "Editor" veya "Write" izniyle oluştur.
SANITY_WRITE_TOKEN=your_sanity_write_token_here
